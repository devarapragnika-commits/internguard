{
  "manifest_version": 3,
  "name": "InternGuard Inbox",
  "version": "0.3.0",
  "description": "Scores a LinkedIn or Indeed listing from the open page, and badges Gmail list rows from subject, sender, and snippet.",
  "action": {
    "default_title": "InternGuard Inbox",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://linkedin.com/*",
        "https://www.indeed.com/*",
        "https://indeed.com/*"
      ],
      "js": ["listing.js"],
      "run_at": "document_idle"
    }
  ]
}
