{
  "manifest_version": 3,
  "name": "InternGuard Inbox",
  "version": "0.2.0",
  "description": "Shows a low, medium, or high risk badge on Gmail list rows from subject, sender, and snippet. Sandbox fixtures still work with no Gmail account.",
  "action": {
    "default_title": "InternGuard Inbox",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
